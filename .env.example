# .env.example — Grapez Analytics Agents
# Copiar a .env y completar los valores
# NUNCA commitear .env al repositorio

# ─── Google Cloud ──────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=grapez-ecosistema-medicion
GOOGLE_CLOUD_LOCATION=us-central1
# Obligatorio: fuerza a ADK a usar Vertex AI (sin esto pide GOOGLE_API_KEY y falla)
GOOGLE_GENAI_USE_VERTEXAI=true
# Autenticación local: gcloud auth application-default login

# ─── Google OAuth (para conectar cuentas de clientes) ──────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Crear en: GCP Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Tipo: Web application
# Redirect URI (local): http://localhost:3000/api/oauth/google/callback
# Redirect URI (prod): https://TU_CLOUD_RUN_URL/api/oauth/google/callback
OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# ─── Vertex AI Agent Engine ────────────────────────────────
AGENT_ENGINE_REGION=us-central1
AGENT_ENGINE_PROJECT=grapez-ecosistema-medicion
# Lo asigna el primer deploy con: .\scripts\deploy-agents.ps1
# Un solo ID: el Planner importa los sub-agentes como módulos (un solo deploy)
PLANNER_AGENT_ENGINE_ID=

# ─── Microservicios Cloud Run ──────────────────────────────
PLAYWRIGHT_SERVICE_URL=
# URL del Playwright Service (crawl/screenshots/análisis de tracking)
# Ej: https://playwright-service-xxxx-uc.a.run.app
# Vacía en desarrollo local → las tools apuntan a http://localhost:8080

BRAVE_MCP_URL=
# URL del Brave MCP Server en Cloud Run (asignada después del primer deploy)
# Ej: https://brave-mcp-server-xxxx-uc.a.run.app/mcp
# Vacía en desarrollo local → el agente usa HTTP directo a Brave API como fallback

BRAVE_API_KEY=
# Obtener gratis en: https://brave.com/search/api/ (free tier: 2,000 req/mes)
# Usado por el Brave MCP Server y como fallback directo en desarrollo local

# ─── Frontend Next.js ──────────────────────────────────────
# El frontend usa frontend/.env.local (dev) y frontend/.env.cloudrun.yaml (prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── OAuth Session (iron-session) ──────────────────────────
SESSION_SECRET=
# Generar con: openssl rand -base64 32

# ─── Tokens de prueba para desarrollo local de agentes ─────
# Generar en el navegador: corre el frontend y abre /dev/tokens
# SOLO para desarrollo local — NUNCA commitear ni a producción
TEST_ACCESS_TOKEN=
TEST_REFRESH_TOKEN=

# ─── Demo Environment ──────────────────────────────────────
# IDs de las cuentas demo (llenar después de crearlas)
DEMO_GTM_ACCOUNT_ID=
DEMO_GTM_CONTAINER_ID=
DEMO_WEBSITE_URL=
