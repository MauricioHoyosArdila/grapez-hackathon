# .env.example — Grapez Analytics Agents
# Copiar a .env y completar los valores
# NUNCA commitear .env al repositorio

# ─── Google Cloud ──────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=grapez-hackathon
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Descargar desde: GCP Console → IAM → Service Accounts → tu SA → Keys → JSON

# ─── Google OAuth (para conectar cuentas de clientes) ──────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Crear en: GCP Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Tipo: Web application
# Redirect URI (local): http://localhost:3000/api/oauth/google/callback
# Redirect URI (prod): https://TU_CLOUD_RUN_URL/api/oauth/google/callback
OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# ─── Agent Engine ──────────────────────────────────────────
AGENT_ENGINE_REGION=us-central1
AGENT_ENGINE_PROJECT=grapez-hackathon
# IDs se asignan después del primer deploy con: adk deploy agent_engine
PLANNER_AGENT_ENGINE_ID=
GA4_AGENT_ENGINE_ID=
GTM_AGENT_ENGINE_ID=
WEB_ANALYZER_AGENT_ENGINE_ID=
IMPLEMENTATION_AGENT_ENGINE_ID=

# ─── Gemini ────────────────────────────────────────────────
# Opción A: Vertex AI (recomendado para hackathon — usa crédito GCP)
# No necesita key si GOOGLE_APPLICATION_CREDENTIALS está configurado

# Opción B: API key directa (solo para desarrollo local rápido)
GOOGLE_GEMINI_API_KEY=

# ─── Firestore ─────────────────────────────────────────────
FIRESTORE_DATABASE=(default)
# No necesita config adicional si GOOGLE_APPLICATION_CREDENTIALS está bien

# ─── Encriptación de tokens OAuth ──────────────────────────
ENCRYPTION_KEY=
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANTE: guardar este key en Secret Manager en producción

# ─── Frontend Next.js ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En producción: tu URL de Cloud Run

# ─── OAuth Session (iron-session) ──────────────────────────
SESSION_SECRET=
# Generar con: openssl rand -base64 32
# En producción: guardar en Secret Manager

# ─── Tokens de prueba para desarrollo local de agentes ─────
# Generar con: python scripts/generate_test_tokens.py
# SOLO para desarrollo local — NUNCA commitear ni a producción
TEST_ACCESS_TOKEN=
TEST_REFRESH_TOKEN=

# ─── Brave Search MCP ─────────────────────────────────────
BRAVE_API_KEY=
# Obtener gratis en: https://brave.com/search/api/ (free tier: 2,000 req/mes)
# Usado por el Brave MCP Server (Cloud Run) — el agente no lo lee directamente

BRAVE_MCP_URL=
# URL del Brave MCP Server en Cloud Run (asignada después del primer deploy)
# Ej: https://brave-mcp-server-xxxx-uc.a.run.app/mcp
# Vacía en desarrollo local → el agente usa HTTP directo a Brave API como fallback

# ─── Demo Environment ──────────────────────────────────────
# IDs de las propiedades demo (llenar después de crearlas)
DEMO_GA4_PROPERTY_ID=
DEMO_GTM_ACCOUNT_ID=
DEMO_GTM_CONTAINER_ID=
DEMO_GOOGLE_ADS_CUSTOMER_ID=
DEMO_WEBSITE_URL=https://tiendademo.vercel.app
